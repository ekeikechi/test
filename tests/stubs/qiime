#!/usr/bin/env bash
# Test stub for `qiime`: records each call in $SMOKE_LOG and fakes its outputs, so the
# pipeline's control flow and file chaining can be tested without QIIME 2 installed.
# It fails like the real CLI would when an input is missing or an output already exists.
echo "qiime $*" >> "$SMOKE_LOG"
args=("$@")

# Release-specific interfaces (checked against plugin source at each release tag).
# STUB_EPOCH is the Q2_EPOCH of the configuration under test (set by smoke_test.sh).
epoch="${STUB_EPOCH:-2026.7}"
ge() { [[ "$(printf '%s\n%s\n' "$epoch" "$1" | sort -V | head -n1)" == "$1" ]]; }
fail() { echo "STUB ($epoch): $*" >&2; exit 5; }
has() { local a; for a in "${args[@]}"; do [[ "$a" == "$1" ]] && return 0; done; return 1; }
case "$1 $2" in
    "cutadapt trim-paired" | "cutadapt trim-single")
        # q2-cutadapt 2026.7 added the required output --o-stats.
        if ge 2026.7; then has --o-stats || fail "Missing option '--o-stats'."
        else ! has --o-stats || fail "No such option: --o-stats"; fi ;;
    "composition ancombc2-visualizer")
        # removed in q2-composition 2026.7
        ! ge 2026.7 || fail "No such command 'ancombc2-visualizer'." ;;
    "feature-table summarize" | "diversity alpha-rarefaction")
        # both fail on metadata without data columns (summarize 2026.7: "list index out
        # of range"; alpha-rarefaction: "All metadata filtered after dropping columns")
        for ((i = 0; i < ${#args[@]}; i++)); do
            [[ ${args[i]} == --m-metadata-file ]] || continue
            m=${args[i + 1]}
            cols=$(awk -F'\t' '/^[[:space:]]*$/ {next} /^#/ && $1 !~ /^#(SampleID|Sample ID)$/ {next} {n = NF - 1; exit} END {print n + 0}' "$m")
            [[ "$cols" -gt 0 ]] || fail "$1 $2 on metadata without data columns ($m)"
        done ;;
    "composition da-barplot")
        # takes ANCOM-BC2 output (and --i-taxonomy) only from 2026.7
        ge 2026.7 || fail "da-barplot does not accept FeatureData[ANCOMBC2Output] before 2026.7." ;;
esac

if [[ "$1 $2" == "tools export" ]]; then
    for ((i = 0; i < ${#args[@]}; i++)); do
        [[ ${args[i]} == --output-path ]] && out=${args[i + 1]}
        [[ ${args[i]} == --input-path ]] && in=${args[i + 1]}
    done
    mkdir -p "$out"
    case "$in" in
        *reads_trimmed_summary.qzv)   # per-position quality; profile from STUB_QUALITY_PROFILE
            python3 "$(dirname "$0")/../make_seven_number.py" "$out" "${STUB_QUALITY_PROFILE:-2x300}" ;;
        *taxonomy*) touch "$out/taxonomy.tsv" ;;
        *rep_seqs*) touch "$out/dna-sequences.fasta" ;;
        *tree*)     touch "$out/tree.nwk" ;;
        *stats*)    touch "$out/metadata.tsv" ;;
        *)          touch "$out/feature-table.biom" ;;
    esac
    exit 0
fi

if [[ "$1" == tools ]]; then   # import, replay-provenance, replay-supplement
    for ((i = 0; i < ${#args[@]}; i++)); do
        [[ ${args[i]} == --output-path || ${args[i]} == --out-fp ]] && touch "${args[i + 1]}"
    done
    exit 0
fi

for ((i = 0; i < ${#args[@]}; i++)); do
    a=${args[i]}; v=${args[i + 1]:-}
    case "$a" in
        --o-alpha-diversities) mkdir -p "$v"; touch "$v"/{shannon,observed_features,pielou_e,faith_pd}.qza ;;
        --o-distance-matrices) mkdir -p "$v"; touch "$v"/{braycurtis,jaccard,unweighted_unifrac,weighted_unifrac}.qza ;;
        --o-resampled-tables | --o-pcoas | --o-emperor-plots | --o-kmer-tables) mkdir -p "$v" ;;
        --o-*)
            [[ -d "$(dirname "$v")" ]] || { echo "STUB: missing dir for $v" >&2; exit 3; }
            [[ -e "$v" ]] && { echo "STUB: output exists $v" >&2; exit 4; }
            touch "$v" ;;
        --i-*)
            [[ "$v" == *:* ]] && v=${v#*:}   # key:path collection syntax
            [[ -e "$v" ]] || { echo "STUB: missing input $a $v" >&2; exit 2; } ;;
    esac
done
exit 0
